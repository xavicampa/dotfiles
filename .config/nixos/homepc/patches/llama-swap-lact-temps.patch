+// lactGpuTemp picks the core temperature out of a LACT sensor map. LACT names AMD
+// sensors "edge"/"junction" and NVIDIA sensors "GPU"/"GPU Hotspot"; the fallback must
+// not pick a memory or hotspot sensor at random just because map iteration order is
+// not stable.
+func lactGpuTemp(temps map[string]lactTempEntry) int {
+	for _, key := range []string{"edge", "junction", "GPU"} {
+		if t, ok := temps[key]; ok && t.Current != nil && *t.Current > 0 {
+			return int(*t.Current)
+		}
+	}
+
+	for name, t := range temps {
+		lower := strings.ToLower(name)
+		if strings.Contains(lower, "vram") || strings.Contains(lower, "hotspot") || strings.Contains(lower, "mem") {
+			continue
+		}
+		if t.Current != nil && *t.Current > 0 {
+			return int(*t.Current)
+		}
+	}
+
+	return 0
+}
+
+// lactVramTemp picks the VRAM temperature out of a LACT sensor map. AMD uses "mem",
+// NVIDIA an aggregate "VRAM" sensor, but the NVIDIA driver only exposes that aggregate
+// when NVAPI reports a VRAM thermal channel - cards without one (Blackwell GDDR7) only
+// report per-chip sensors such as "VRAM Chip B0", so fall back to the hottest of those.
+func lactVramTemp(temps map[string]lactTempEntry) int {
+	for _, key := range []string{"mem", "VRAM"} {
+		if t, ok := temps[key]; ok && t.Current != nil && *t.Current > 0 {
+			return int(*t.Current)
+		}
+	}
+
+	var hottest float64
+	for name, t := range temps {
+		if !strings.Contains(strings.ToLower(name), "vram") {
+			continue
+		}
+		if t.Current != nil && *t.Current > hottest {
+			hottest = *t.Current
+		}
+	}
+
+	return int(hottest)
+}
