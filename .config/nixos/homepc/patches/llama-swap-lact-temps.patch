+func TestLactTempSelection(t *testing.T) {
+	// LACT sensor names as reported for an RTX 3090 Ti (NVAPI exposes an aggregate
+	// VRAM channel) and an RTX 5070 Ti (Blackwell: only per-chip VRAM sensors).
+	ptr := func(v float64) *float64 { return &v }
+
+	nvidiaAmpere := map[string]lactTempEntry{
+		"GPU":          {Current: ptr(55)},
+		"GPU Hotspot":  {Current: ptr(65)},
+		"VRAM":         {Current: ptr(54)},
+		"VRAM Chip A0": {Current: ptr(54)},
+		"VRAM Chip B1": {Current: ptr(50)},
+	}
+	nvidiaBlackwell := map[string]lactTempEntry{
+		"GPU":          {Current: ptr(51)},
+		"GPU Hotspot":  {Current: ptr(54)},
+		"VRAM Chip A0": {Current: ptr(62)},
+		"VRAM Chip B0": {Current: ptr(64)},
+		"VRAM Chip D0": {Current: ptr(60)},
+	}
+	amd := map[string]lactTempEntry{
+		"edge":     {Current: ptr(38)},
+		"junction": {Current: ptr(41)},
+		"mem":      {Current: ptr(39)},
+	}
+
+	// map iteration order is not stable, so repeat to catch order-dependent picks
+	for i := 0; i < 50; i++ {
+		assert.Equal(t, 55, lactGpuTemp(nvidiaAmpere))
+		assert.Equal(t, 54, lactVramTemp(nvidiaAmpere))
+		assert.Equal(t, 51, lactGpuTemp(nvidiaBlackwell))
+		assert.Equal(t, 64, lactVramTemp(nvidiaBlackwell))
+		assert.Equal(t, 38, lactGpuTemp(amd))
+		assert.Equal(t, 39, lactVramTemp(amd))
+	}
+
+	assert.Equal(t, 0, lactGpuTemp(map[string]lactTempEntry{}))
+	assert.Equal(t, 0, lactVramTemp(map[string]lactTempEntry{}))
+}
