-- ─── window rules (hyprlang windowrule lines) ───────────────────────────────
-- (see the hyprland.start block below for how they are applied)
hl.on("hyprland.start", function()
    -- Window rules kept as `hyprctl keyword` so the legacy rule names
    -- (stay_focused, dim_around) keep working. DMS's own rules live in
    -- dms/windowrules.lua, managed by `dms window-rules`.
    hl.exec_cmd("hyprctl keyword windowrulev2 'float,class:^(com.onepassword.OnePassword)$'")
    hl.exec_cmd("hyprctl keyword windowrulev2 'stay_focused,title:^(Hyprland Polkit Agent)$'")
    hl.exec_cmd("hyprctl keyword windowrulev2 'dim_around,title:^(Hyprland Polkit Agent)$'")
    hl.exec_cmd("hyprctl keyword windowrulev2 'stay_focused,title:^(Unlock Login Keyring)$'")
    hl.exec_cmd("hyprctl keyword windowrulev2 'dim_around,title:^(Unlock Login Keyring)$'")
    -- workspace = special:magic, on-created-empty:kitty
    hl.exec_cmd("hyprctl keyword workspacerule special:magic,on-created-empty:kitty")
end)

-- ─── keybinds ───────────────────────────────────────────────────────────────
local mainMod     = "ALT"
local terminal    = "kitty"
local fileManager = "nautilus"
local menu        = "rofi -show drun"
local tabmenu     = "rofi -show"
local emoji       = "rofimoji --action clipboard"

hl.bind(mainMod .. " + Return",          hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + CTRL + Return",   hl.dsp.exec_cmd("kitty pi"))
hl.bind(mainMod .. " + C",               hl.dsp.window.close())
hl.bind(mainMod .. " + E",               hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + V",               hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + F",               hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" }))
-- CONTESTED: dms.binds also binds ALT + space (DMS spotlight-bar). This line
-- loads later so rofi wins; delete it to hand the key back to DMS.
hl.bind(mainMod .. " + Space",           hl.dsp.exec_cmd(menu))
hl.bind(mainMod .. " + Tab",             hl.dsp.exec_cmd(tabmenu))
hl.bind(mainMod .. " + CTRL + Space",    hl.dsp.exec_cmd(emoji))
hl.bind(mainMod .. " + P",               hl.dsp.window.pseudo())
hl.bind(mainMod .. " + backspace",       hl.dsp.exec_cmd("/home/javi/.config/rofi/powermenu.sh"))

-- homepc.conf: bind = $mainMod SHIFT, P, exec, ~/.config/rofi/displaymenu_homepc.sh
hl.bind(mainMod .. " + SHIFT + P",       hl.dsp.exec_cmd("/home/javi/.config/rofi/displaymenu_homepc.sh"))

-- Screenshots
hl.bind(mainMod .. " + SHIFT + 4",       hl.dsp.exec_cmd("hyprshot -m region"))
hl.bind(mainMod .. " + SHIFT + 5",       hl.dsp.exec_cmd("hyprshot -m window"))

-- Focus / move window (HJKL)
hl.bind(mainMod .. " + H",               hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + L",               hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + K",               hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + J",               hl.dsp.focus({ direction = "down" }))

-- movewindow / movecurrentworkspacetomonitor: legacy dispatchers via hyprctl,
-- kept as-is because the Lua equivalents are not documented for these two.
hl.bind(mainMod .. " + SHIFT + H",       hl.dsp.exec_cmd("hyprctl dispatch movewindow l"))
hl.bind(mainMod .. " + SHIFT + L",       hl.dsp.exec_cmd("hyprctl dispatch movewindow r"))
hl.bind(mainMod .. " + SHIFT + K",       hl.dsp.exec_cmd("hyprctl dispatch movewindow u"))
hl.bind(mainMod .. " + SHIFT + J",       hl.dsp.exec_cmd("hyprctl dispatch movewindow d"))
hl.bind(mainMod .. " + CTRL + H",        hl.dsp.exec_cmd("hyprctl dispatch movecurrentworkspacetomonitor l"))
hl.bind(mainMod .. " + CTRL + L",        hl.dsp.exec_cmd("hyprctl dispatch movecurrentworkspacetomonitor r"))

-- Workspaces
for i = 1, 4 do
    hl.bind(mainMod .. " + CTRL + " .. i,     hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + CTRL + SHIFT + " .. i, hl.dsp.window.move({ workspace = i }))
end

-- Special workspace (scratchpad)
hl.bind(mainMod .. " + code:61",              hl.dsp.workspace.toggle_special("magic"))
hl.bind(mainMod .. " + CTRL + SHIFT + code:61", hl.dsp.window.move({ workspace = "special:magic" }))

-- Scroll through workspaces
hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mainMod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

-- Move/resize with mouse
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Display brightness per monitor (ddcutil; DMS's brightness widget does not
-- split per output, so these stay)
hl.bind("F1", hl.dsp.exec_cmd("ddcutil setvcp 10 - 25 --display 1"))
hl.bind("F2", hl.dsp.exec_cmd("ddcutil setvcp 10 + 25 --display 1"))
hl.bind("F3", hl.dsp.exec_cmd("ddcutil setvcp 10 - 25 --display 2"))
hl.bind("F4", hl.dsp.exec_cmd("ddcutil setvcp 10 + 25 --display 2"))

-- Media / brightness keys: dms.binds already binds XF86Audio* and XF86MonBrightness*
-- to `dms ipc call audio|brightness` (with DMS's own OSD). Your old pamixer/light
-- binds used the same keys and called `dunstify`, which is gone with dunst, so
-- they are dropped. Uncomment to take them back (and lose DMS's OSD for them).
-- hl.bind("code:232", hl.dsp.exec_cmd("light -U 25"))
-- hl.bind("code:233", hl.dsp.exec_cmd("light -A 25"))
-- hl.bind("code:121", hl.dsp.exec_cmd("pamixer -t"))
-- hl.bind("code:122", hl.dsp.exec_cmd("pamixer -d 5"))
-- hl.bind("code:123", hl.dsp.exec_cmd("pamixer -i 5"))

-- Waybar is not autostarted anymore (NixOS: waybar wantedBy cleared); this bind
-- is kept only in case you re-enable it.
-- hl.bind(mainMod .. " + B", hl.dsp.exec_cmd("pkill -SIGUSR1 waybar"))
