-- Hyprland Lua config root (Hyprland 0.55+).
--
-- Why this file exists: DMS 1.6.2 is Lua-native. On start it backs up
-- ~/.config/hypr to ~/.config/hypr/.dms-backups/<ts>/ and replaces the hyprlang
-- hyprland.conf with a 6-bind stub ("This config is a STUB!"), because Hyprland
-- loads hyprland.lua *instead of* hyprland.conf when the .lua is present.
-- Restoring the old conf only lasts until the next dms.service start.
--
-- Your original hyprlang config: ~/.config/hypr/.dms-backups/2026-10-16_11-09-18/hyprland.conf
-- Homepc-specific hyprlang file (still on disk, now inert): ~/.config/hypr/homepc.conf
--
-- Reference: https://wiki.hypr.land/configuring/

-- ─── DMS-managed modules (regenerated by DMS; edit via DMS settings/CLI) ─────
require("dms.colors")      -- matugen border/group colors
require("dms.layout")      -- gaps 4, border 2, rounding 12, dms:bar layer rule
require("dms.windowrules") -- DMS-managed rules (dms window-rules CLI)
require("dms.binds")       -- SUPER-based DMS keybinds; your mainMod is ALT, no clash

-- ════════════════════════════════════════════════════════════════════════════
-- Everything below is ported from your hyprlang config and overrides the DMS
-- defaults above (last call wins). Comment a block out to hand it back to DMS.
-- ════════════════════════════════════════════════════════════════════════════

-- ─── env (hyprland.conf + homepc.conf) ──────────────────────────────────────
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("XCURSOR_THEME", "macOS")
hl.env("XCURSOR_SIZE", "24")
hl.env("LIBVA_DRIVER_NAME", "iHD")

-- ─── monitors + devices (homepc.conf) ───────────────────────────────────────
-- On dell, adjust here or split into a per-host module: require("dell")
hl.monitor({ output = "HDMI-A-1", mode = "preferred", position = "auto", scale = 1.5 })
hl.monitor({ output = "DP-1", disabled = true })
hl.monitor({ output = "DP-2", disabled = true })
hl.monitor({ output = "DP-3", disabled = true })

hl.device({ name = "logitech-g-pro--1", natural_scroll = true })
hl.device({ name = "logitech-g-pro-wireless-gaming-mouse-2", natural_scroll = true })

-- ─── misc / xwayland / input ────────────────────────────────────────────────
-- hl.config({
--     xwayland = { force_zero_scaling = true },
-- })

hl.config({
    input = {
        sensitivity  = -1.9,
        kb_layout    = "no",
        kb_variant   = "",
        kb_model     = "",
        kb_options   = "",
        kb_rules     = "",
        follow_mouse = 1,
    },
})

