.hermes/
.1password/
.ssh/
.aws/
.aws-sam/
.appgate/
.buddy/
.claude/
.claude.json
.kiro/
.semantic_search/
.npmrc
.config/1Password/
.config/AppGate/
.config/appgatesdp-service/
.config/hermes/ssh-image/
.config/pulse/
.config/opencode/auth.json
.config/transmission/

# .agents/skills/readynas/ documents ReadyNAS root access (passwordless root in OS 6
# recovery) plus the factory admin credential, and telnet-step.exp drives it. Kept
# out of the public repo; add with `git add -f` only after scrubbing.
.agents/skills/readynas/
.config/go/
.config/pi/web-search-cache/

