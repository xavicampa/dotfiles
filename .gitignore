.pi/agent/settings.json
.DS_Store
*.swp

# --- DMS / Hyprland generated artifacts (derived from .config/DankMaterialShell/settings.json) ---
# These are all re-derived by DMS from the tracked settings.json, so they are noise.
.config/hypr/dms/binds.lua
.config/hypr/dms/colors.lua
.config/hypr/dms/layout.lua
.config/hypr/dms/cursor.lua
.config/hypr/dms/input.lua
.config/hypr/dms/windowrules.lua

# EXCEPTION — do NOT ignore .config/hypr/dms/outputs.lua: DMS's Settings -> Displays
# page writes monitor mode/position/scale/VRR only there (and in the untracked
# ~/.local/state/DankMaterialShell/session.json under hyprlandOutputSettings), never
# in settings.json. It is the only durable, source-controllable record of the display
# scale (HDMI-A-1 scale = 1.3333). hyprland.lua require()s it behind a hostname guard
# (HOST == "homepc") because this generated file is per-host — expect a dirty diff
# whenever displays are reconfigured, and commit it from the host it belongs to.
.config/DankMaterialShell/firefox.css
.config/DankMaterialShell/settings.json.bak*
.config/DankMaterialShell/.changelog-*
.config/DankMaterialShell/.firstlaunch
.config/hypr/hyprland.lua.bak
.config/hypr/hyprland.lua.backup*
.config/hypr/.dms-backups/
